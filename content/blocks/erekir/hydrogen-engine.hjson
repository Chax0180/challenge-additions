type: ConsumeGenerator
name: Hydrogen Fusor
description: Generates power by fusing hydrogen at a very small scale.
details: The fusion process outputs more energy than simply combusting hydrogen and oxygen, which would have no net gain if both were obtained from water. The same problem occurs when attempting to obtain hydrogen from the resulting helium via fission.
size: 3
category: power
research: {
  parent: electrolyzer
  objectives: [
    {
      type: OnSector
      preset: caldera-erekir
    }
  ]
}
requirements: [
  graphite/160
  silicon/20
  tungsten/80
  beryllium/120
  oxide/20
]
consumes: {
  liquid: hydrogen/0.066666666666666666666666666666
}
hasLiquids: true
liquidCapacity: 30
powerProduction: 12
  
ambientSound: loopMachineSpin
